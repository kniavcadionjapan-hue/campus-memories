{
  "name": "campus-memories",
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "photos/*.{jpg,JPG,jpeg,JPEG,png,PNG,gif,GIF,webp,WEBP,heic,HEIC}",
      "use": "@vercel/static"
    },
    {
      "src": "photo_data.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/photo_data.json",
      "dest": "/photo_data.json"
    },
    {
      "src": "/photos/(.*)",
      "dest": "/photos/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
